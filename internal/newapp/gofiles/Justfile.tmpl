origin := env("ORIGIN", "{{.Origin}}")

_default:
    @just --list --unsorted


install:
    cd web && vp install --frozen-lockfile

# For Vite/Kit development, run `go tool skgo dev` from this directory.
# See README.md for its exact Go version, supported hosts and limitations.

# Build the frontend and the standalone Go binary.
build:
    go generate ./...
    cd web && ORIGIN="{{"{{origin}}"}}" vp build
    mkdir -p bin
    go build -ldflags "-X main.origin={{"{{origin}}"}}" -o bin/{{.App}} ./cmd

# Run the standalone binary. Node is not involved.
serve: build
    ./bin/{{.App}}

# Run the upstream-installed Vitest suite.
test:
    cd web && vp run test

# Open the upstream-installed Storybook.
storybook:
    cd web && vp run storybook --host 127.0.0.1
