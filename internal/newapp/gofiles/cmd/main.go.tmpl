// Command {{.App}} serves the SvelteKit application from Go.
package main

import (
	"flag"
	"io/fs"
	"log"
	"net/http"
	"net/url"

	app "{{.Module}}"
	"{{.Module}}/web"
)

var origin = "{{.Origin}}"

func main() {
	listen := flag.String("listen", hostPort(origin), "address to listen on")
	trusted := flag.String("origin", origin, "public browser origin")
	flag.Parse()

	dist, err := fs.Sub(web.Build, "build")
	if err != nil {
		log.Fatal(err)
	}
	handler, err := app.NewHandler(dist, *trusted)
	if err != nil {
		log.Fatal(err)
	}
	log.Printf("{{.App}}: listening on http://%s", *listen)
	if err := http.ListenAndServe(*listen, handler); err != nil {
		log.Fatal(err)
	}
}

func hostPort(value string) string {
	u, err := url.Parse(value)
	if err != nil || u.Host == "" {
		return "{{.OriginHostPort}}"
	}
	return u.Host
}
