module {{.Module}}

go {{.GoVersion}}

// Route directories such as [id] are not Go-nameable; skgo compiles them
// through internal/skgo/_links instead.
ignore (
	./web/node_modules
	./web/src/routes
)

require github.com/tylergannon/skgo {{.SkgoVersion}}

tool github.com/tylergannon/skgo/cmd/skgo
{{if .SkgoReplace}}
replace github.com/tylergannon/skgo => {{.SkgoReplace}}
{{end}}
