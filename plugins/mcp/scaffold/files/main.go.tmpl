// Created by the SKGO MCP scaffold. This file belongs to the application.
package main

import (
    _ "embed"
    "flag"
    "log"
    "net/http"
    "os"

    "github.com/mark3labs/mcp-go/server"
    client "{{.Module}}/internal/mcpclient"
    "github.com/tylergannon/skgo/plugins/mcp/remoteclient"
)

//go:embed instructions.md
var instructions string

func main() {
    origin := flag.String("origin", os.Getenv("SKGO_ORIGIN"), "application origin (or SKGO_ORIGIN)")
    base := flag.String("base", "", "Kit base path")
    appDir := flag.String("app-dir", "_app", "Kit app directory")
    flag.Parse()
    if *origin == "" { log.Fatal("-origin or SKGO_ORIGIN is required") }

    // Configure the application's authentication and HTTP connection here.
    // These credentials go to the application, never into tool documentation.
    headers := http.Header{}
    if token := os.Getenv("SKGO_TOKEN"); token != "" {
        headers.Set("Authorization", "Bearer " + token)
    }
    if key := os.Getenv("SKGO_API_KEY"); key != "" {
        headers.Set("X-API-Key", key)
    }
    c := &client.Client{Remote: remoteclient.Client{
        Origin: *origin, Base: *base, AppDir: *appDir, Headers: headers,
        // Set HTTP to your own *http.Client for application-specific transport.
    }}
    s := server.NewMCPServer({{printf "%q" .Name}}, "dev",
        server.WithInstructions(instructions),
        server.WithToolCapabilities(false),
    )
    s.AddTools(c.Tools()...)
    // Register additional application tools, resources and prompts here.
    if err := server.ServeStdio(s); err != nil { log.Fatal(err) }
}
