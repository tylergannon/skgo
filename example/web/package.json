{
  "name": "skgo-example-web",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "build": "vp build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "bits-ui": "2.21.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/sdk-trace-base": "2.12.1",
    "@opentelemetry/sdk-trace-node": "2.12.1",
    "@skgo/sveltekit-adapter": "link:../../internal/adapter",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  }
}
